{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "baseUrl": ".",
        "paths": {
            "../../shared/*": [
                "../shared/*"
            ]
        }
    },
    "include": [
        "src",
        "../shared"
    ],
    "exclude": [
        "src/**/__tests__",
        "src/**/*.test.ts",
        "src/**/*.spec.ts"
    ]
}