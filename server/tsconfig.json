{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "outDir": "dist"
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/**/__tests__",
        "src/**/*.test.ts",
        "src/**/*.spec.ts"
    ]
}